<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net9.0-ios;net9.0-android</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>MasTacos.Maui</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Display name -->
        <ApplicationTitle>MasTacos.Maui</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.mastacos.maui</ApplicationId>
        <ApplicationIdGuid>YOUR-GUID-HERE</ApplicationIdGuid>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.2</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <PropertyGroup Condition="$(TargetFramework.Contains('-ios')) and '$(Configuration)' == 'Release'">
        <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
        <CreatePackage>false</CreatePackage>
    </PropertyGroup>

    <PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Release'">
        <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
        <CreatePackage>false</CreatePackage>
    </PropertyGroup>

    <!-- Custom Targets for iOS Simulators -->
    <!-- dotnet build -t:RunIphone15Pro -->
    <Target Name="RunIPhone15Pro">
        <Exec Command="dotnet build -f net9.0-ios -t:Run -p:_DeviceName=:v2:udid=EBDFCB55-AC5C-424E-959F-E91C4748BD8D" />
    </Target>

    <Target Name="RunIPhone15ProMax">
        <Exec Command="dotnet build -f net9.0-ios -t:Run -p:_DeviceName=:v2:udid=24F648F5-9BBD-4308-86C4-C4F6DD05E58F" />
    </Target>

    <Target Name="RunIPhoneSE">
        <Exec Command="dotnet build -f net9.0-ios -t:Run -p:_DeviceName=:v2:udid=5EBC1777-EF86-454D-8060-FCC5D472E314" />
    </Target>

    <Target Name="RunIPadPro">
        <Exec Command="dotnet build -f net9.0-ios -t:Run -p:_DeviceName=:v2:udid=YOUR-IPAD-PRO-UDID" />
    </Target>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="9.0.0.0" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0.0" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0.0" />
    </ItemGroup>

    <PropertyGroup>
        <EnableDefaultContentItems>false</EnableDefaultContentItems>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="wwwroot\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToiOSBundle>true</CopyToiOSBundle>
        </Content>
    </ItemGroup>

</Project>
